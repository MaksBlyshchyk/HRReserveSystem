# ================================
# Environment Configuration Example
# ================================
# Copy this file to .env and fill in your values

# Application Environment
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration
DATABASE_PROVIDER=PostgreSQL
# Format: Host=hostname;Port=5432;Database=dbname;Username=user;Password=pass;Include Error Detail=false
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=hrreserve;Username=hrreserve;Password=change-me;Include Error Detail=false

# Alternatively, use DATABASE_URL (for services like Render):
# DATABASE_URL=postgres://hrreserve:change-me@localhost:5432/hrreserve

# Email Configuration (Optional)
Email__Enabled=false
Email__Host=smtp.example.com
Email__Port=587
Email__UseSsl=true
Email__UserName=your-email@example.com
Email__Password=your-app-password
Email__FromEmail=no-reply@hrreserve.local
Email__FromName=HR Reserve System
Email__RedirectAllTo=

# Docker & Postgres
APP_PORT=8080
POSTGRES_DB=hrreserve
POSTGRES_USER=hrreserve
POSTGRES_PASSWORD=change-me

# Security Settings
SECURITY_USE_HTTPS_REDIRECTION=false
SECURITY_COOKIE_SECURE_POLICY=SameAsRequest

# Logging
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT__ASPNETCORE=Warning
LOGGING__LOGLEVEL__MICROSOFT__ENTITYFRAMEWORKCORE__DATABASE__COMMAND=Warning

