@{
    ViewData["Title"] = "Access denied";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-warning">
            <div class="card-body p-4">
                <span class="badge text-bg-warning text-dark mb-3">403</span>
                <h1 class="h3">Доступ обмежено</h1>
                <p class="text-muted mb-4">Вашій ролі недостатньо прав для цієї операції.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">На Dashboard</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-secondary" type="submit">Увійти під іншим користувачем</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
