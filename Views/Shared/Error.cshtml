@model ErrorViewModel
@{
    ViewData["Title"] = "Помилка";
}

<section class="py-4">
    <h1 class="text-danger">Помилка</h1>
    <p class="lead">Під час обробки запиту сталася помилка.</p>

    @if (Model.StatusCode.HasValue)
    {
        <p>
            <strong>Код відповіді:</strong> <code>@Model.StatusCode</code>
        </p>
    }

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <p class="text-muted">Якщо проблема повторюється, передайте Request ID адміністратору системи.</p>
</section>
