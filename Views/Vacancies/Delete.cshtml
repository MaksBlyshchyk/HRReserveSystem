@model Vacancy

@{
    ViewData["Title"] = "Архівувати вакансію";
}

<h1 class="h2 mb-3">Архівувати вакансію</h1>
<div class="alert alert-warning">Вакансія <strong>@Model.Title</strong> буде прихована зі списку, але заявки та історія співбесід залишаться в системі.</div>

<dl class="row">
    <dt class="col-sm-3">Статус</dt>
    <dd class="col-sm-9"><span class="badge @HrOptions.VacancyStatusBadge(Model.Status)">@Model.Status</span></dd>
    <dt class="col-sm-3">Зарплата</dt>
    <dd class="col-sm-9">@Model.SalaryMin - @Model.SalaryMax</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Архівувати</button>
    <a class="btn btn-secondary" asp-action="Index">Назад до списку</a>
</form>
